{
  "name": "party-planner",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:web && alchemy dev",
    "dev:web": "vite --config frontend/vite.config.ts",
    "dev:all": "bun run --parallel dev dev:web",
    "build:web": "vite build --config frontend/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "effect-language-service patch",
    "lint": "oxlint --config oxlint.config.ts --disable-nested-config",
    "lint:fix": "oxlint --config oxlint.config.ts --disable-nested-config --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run lint && bun run format:check && bun run typecheck",
    "fix": "bun run lint:fix && bun run format && bun run typecheck",
    "build": "bun run typecheck && bun run build:web",
    "test": "bun test ./test/unit",
    "test:integ": "bun test ./test/integ",
    "deploy": "bun run build && alchemy deploy --stage production"
  },
  "dependencies": {
    "@alchemy.run/better-auth": "2.0.0-beta.80",
    "@effect/platform-browser": "4.0.0",
    "@foldkit/ui": "0.165.0",
    "alchemy": "2.0.0-beta.80",
    "better-auth": "1.7.7",
    "cn": "0.4.0",
    "effect": "4.0.0",
    "foldkit": "0.165.0",
    "kysely": "0.29.6",
    "lucide": "1.50.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260918.1",
    "@effect/language-service": "0.87.3",
    "@effect/platform-bun": "4.0.0",
    "@effect/platform-node": "4.0.0",
    "@foldkit/oxlint-plugin": "0.15.1",
    "@foldkit/vite-plugin": "0.26.0",
    "@oxlint/plugins": "1.86.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "latest",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "^5.9.3",
    "vite": "8.3.2"
  },
  "packageManager": "bun@1.4.2"
}
