{
  "name": "party-planner",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run build:web && alchemy dev",
    "dev:web": "vite --config frontend/vite.config.ts",
    "dev:all": "bun run --parallel dev dev:web",
    "build:web": "vite build --config frontend/vite.config.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "effect-tsgo tsrs --noEmit",
    "lint": "oxlint --config oxlint.config.ts --disable-nested-config",
    "lint:fix": "oxlint --config oxlint.config.ts --disable-nested-config --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "check": "bun run lint && bun run format:check && bun run typecheck",
    "fix": "bun run lint:fix && bun run format && bun run typecheck",
    "build": "bun run typecheck && bun run build:web",
    "test": "bun test ./test/unit",
    "test:integ": "bun test ./test/integ",
    "deploy": "bun run build && alchemy deploy --stage production"
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@alchemy.run/sql": "2.0.0-beta.84",
    "@effect/platform-browser": "4.1.2",
    "@effect/sql-d1": "4.1.2",
    "@foldkit/ui": "0.170.0",
    "@yielded/auth": "0.1.0-beta.47",
    "@yielded/auth-persistence": "0.1.0-beta.47",
    "@yielded/auth-persistence-drizzle": "0.1.0-beta.47",
    "@yielded/crypto": "0.1.0-beta.46",
    "alchemy": "2.0.0-beta.84",
    "cn": "0.5.2",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.1.2",
    "foldkit": "0.170.0",
    "lucide": "1.66.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261102.1",
    "@effect/platform-bun": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@effect/tsgo": "^0.63.0",
    "@foldkit/devtools": "0.170.0",
    "@foldkit/devtools-mcp": "0.26.0",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@foldkit/vite-plugin": "0.29.0",
    "@oxlint/plugins": "1.90.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "^1.4.4",
    "drizzle-kit": "1.0.0-rc.4",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "tailwindcss": "4.3.3",
    "tsrs": "^0.20.1-ts7.1.0-beta",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.5"
  },
  "packageManager": "bun@1.4.4",
  "patchedDependencies": {
    "drizzle-orm@1.0.0-rc.4": "patches/drizzle-orm@1.0.0-rc.4.patch",
    "alchemy@2.0.0-beta.84": "patches/alchemy@2.0.0-beta.84.patch"
  }
}
